# Copy to .env (local development) or set these in Vercel > Settings > Environment Variables.
# These values are placeholders. Never commit real credentials.
#
# None of these use the VITE_ prefix on purpose: variables with that prefix are
# bundled into the browser. Collabo's secrets must stay on the server.

# Neon connection string (Neon console > Connect). Pooled or direct both work.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Signs the project session cookie. At least 32 random characters.
#   openssl rand -base64 48
SESSION_SECRET="replace-with-at-least-32-random-characters"

# Keyed-hash secret for project access codes. At least 32 random characters,
# and different from SESSION_SECRET. Changing it later invalidates every
# existing access code, so treat it as permanent.
#   openssl rand -base64 48
ACCESS_CODE_PEPPER="replace-with-a-different-32-plus-character-secret"

# NEW IN V2 (optional): turns on the platform-admin area (/admin).
# At least 32 random characters, different from both secrets above. It signs
# administrator sessions and encrypts their authenticator (2FA) secrets, so
# changing it later signs every administrator out and makes every enrolled
# authenticator unusable (use `npm run admin:create -- --reset-mfa --email ...`
# to re-enrol). Leave it unset and the admin area answers 503 while everything
# else keeps working.
#   openssl rand -base64 48
ADMIN_AUTH_SECRET="replace-with-a-third-different-32-plus-character-secret"

# Only for the operator scripts (npm run admin:create). Optional: when set, the
# new administrator gets this password instead of being asked for one. Do not
# put a real password in a file that is committed; prefer the interactive prompt.
# ADMIN_BOOTSTRAP_PASSWORD=""
